

cc_binary {
    name: "mm-qcamera-app",
    compile_multilib: "32",
    cflags: [
        "-DAMSS_VERSION=",
        "-DUSE_ION",
        "-D_ANDROID_",
        "-DQCAMERA_REDEFINE_LOG",
        "-DSYSTEM_HEADER_PREFIX=sys",
        "-Wno-compound-token-split-by-macro",
        "-DCAMERA_ION_HEAP_ID=ION_SYSTEM_HEAP_ID",
        "-DCAMERA_GRALLOC_CACHING_ID=GRALLOC_USAGE_PRIVATE_UNCACHED",
        "-DCAMERA_ION_FALLBACK_HEAP_ID=ION_CAMERA_HEAP_ID",
        "-DNUM_RECORDING_BUFFERS=5",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    include_dirs: [
        "device/xiaomi/Mi439/camera/QCamera2/stack/common",
        "device/xiaomi/Mi439/camera/QCamera2/stack/mm-camera-interface/inc",
        "device/xiaomi/Mi439/camera/mm-image-codec/qexif",
        "device/xiaomi/Mi439/camera/mm-image-codec/qomx_core",
    ],
    local_include_dirs: ["inc"],
    header_libs: [
        "libutils_headers",
        "media_plugin_headers",
        "generated_kernel_headers",
    ],

    shared_libs: [
        "libcutils",
        "libdl",
        "liblog",
        "libmmcamera_interface",
        "libion",
    ],
    srcs: [
        "src/mm_qcamera_main_menu.c",
        "src/mm_qcamera_app.c",
        "src/mm_qcamera_unit_test.c",
        "src/mm_qcamera_video.c",
        "src/mm_qcamera_preview.c",
        "src/mm_qcamera_snapshot.c",
        "src/mm_qcamera_rdi.c",
        "src/mm_qcamera_reprocess.c",
        "src/mm_qcamera_queue.c",
        "src/mm_qcamera_socket.c",
        "src/mm_qcamera_commands.c",
    ],
    vendor: true,
}

cc_library_shared {
    name: "libmm-qcamera",
    compile_multilib: "32",
    cflags: [
        "-DAMSS_VERSION=",
        "-DUSE_ION",
        "-D_ANDROID_",
        "-DQCAMERA_REDEFINE_LOG",
        "-DSYSTEM_HEADER_PREFIX=sys",
        "-Wno-compound-token-split-by-macro",
        "-DCAMERA_ION_HEAP_ID=ION_SYSTEM_HEAP_ID",
        "-DCAMERA_GRALLOC_CACHING_ID=GRALLOC_USAGE_PRIVATE_UNCACHED",
        "-DCAMERA_ION_FALLBACK_HEAP_ID=ION_CAMERA_HEAP_ID",
        "-DNUM_RECORDING_BUFFERS=5",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    include_dirs: [
        "device/xiaomi/Mi439/camera/QCamera2/stack/common",
        "device/xiaomi/Mi439/camera/QCamera2/stack/mm-camera-interface/inc",
        "device/xiaomi/Mi439/camera/mm-image-codec/qexif",
        "device/xiaomi/Mi439/camera/mm-image-codec/qomx_core",
    ],
    local_include_dirs: ["inc"],
    header_libs: [
        "libutils_headers",
        "media_plugin_headers",
        "generated_kernel_headers",
    ],

    shared_libs: [
        "libcutils",
        "libdl",
        "liblog",
        "libmmcamera_interface",
        "libion",
    ],
    srcs: [
        "src/mm_qcamera_main_menu.c",
        "src/mm_qcamera_app.c",
        "src/mm_qcamera_unit_test.c",
        "src/mm_qcamera_video.c",
        "src/mm_qcamera_preview.c",
        "src/mm_qcamera_snapshot.c",
        "src/mm_qcamera_rdi.c",
        "src/mm_qcamera_reprocess.c",
        "src/mm_qcamera_queue.c",
        "src/mm_qcamera_socket.c",
        "src/mm_qcamera_commands.c",
    ],
    vendor: true,
}
